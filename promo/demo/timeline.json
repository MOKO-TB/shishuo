  "lines": [
    {
      "id": "a1_1",
      "act": "act1",
      "scene": "intro_flow",
      "text": "这是一条功能演示。",
      "start": 1.1,
      "end": 2.543,
      "dur": 1.443,
      "pause_after": 0.35
    },
    {
      "id": "a1_2",
      "act": "act1",
      "scene": "intro_flow",
      "text": "我们不只展示界面，而是把一次真实的课后答疑，从提问、回答、转交，到老师处理，完整走一遍。",
      "start": 2.893,
      "end": 11.1,
      "dur": 8.207,
      "pause_after": 0.35
    },
    {
      "id": "a1_3",
      "act": "act1",
      "scene": "intro_home",
      "text": "学生叫林晓，晚上十点，她卡在数据结构的一道题上。",
      "start": 11.45,
      "end": 15.866,
      "dur": 4.416,
      "pause_after": 0.35
    },
    {
      "id": "a1_4",
      "act": "act1",
      "scene": "intro_home",
      "text": "接下来发生的每一步，都可以在师说里真实操作。",
      "start": 16.216,
      "end": 20.037,
      "dur": 3.821,
      "pause_after": 0.45
    },
    {
      "id": "a2_1",
      "act": "act2",
      "scene": "stu_course",
      "text": "第一步，选课程。五门试点课放在同一排，点一下数据结构。",
      "start": 21.287,
      "end": 26.744,
      "dur": 5.457,
      "pause_after": 0.3
    },
    {
      "id": "a2_2",
      "act": "act2",
      "scene": "stu_type",
      "text": "输入框支持文字、语音、拍照和文档。林晓直接用自己的话，把卡点敲进去。",
      "start": 27.044,
      "end": 33.657,
      "dur": 6.613,
      "pause_after": 0.3
    },
    {
      "id": "a2_3",
      "act": "act2",
      "scene": "stu_type",
      "text": "SPFA 判负环，为什么入队次数超过 n-1，就说明有负环？",
      "start": 33.957,
      "end": 39.383,
      "dur": 5.426,
      "pause_after": 0.35
    },
    {
      "id": "a2_4",
      "act": "act2",
      "scene": "stu_send",
      "text": "点击交给 AI。系统先在课程知识库里检索，再让模型组织答案，而不是让模型自由发挥。",
      "start": 39.733,
      "end": 47.558,
      "dur": 7.825,
      "pause_after": 0.35
    },
    {
      "id": "a2_5",
      "act": "act2",
      "scene": "stu_answer",
      "text": "回答先给判断，再分三步推导。每个关键结论，都能点回原章节。",
      "start": 47.908,
      "end": 53.562,
      "dur": 5.654,
      "pause_after": 0.3
    },
    {
      "id": "a2_6",
      "act": "act2",
      "scene": "stu_answer",
      "text": "右上角是置信度。中置信，代表有依据，但还不够完整，需要老师补充。",
      "start": 53.862,
      "end": 60.076,
      "dur": 6.213,
      "pause_after": 0.35
    },
    {
      "id": "a2_7",
      "act": "act2",
      "scene": "stu_thread",
      "text": "她继续追问：为什么是 n-1，不是 n？上下文还在，不用重新解释题目。",
      "start": 60.426,
      "end": 66.725,
      "dur": 6.299,
      "pause_after": 0.3
    },
    {
      "id": "a2_8",
      "act": "act2",
      "scene": "stu_file",
      "text": "除了打字，也可以拍照、传讲义。文件先在浏览器本机解析，她看到摘要，确认后才发送。",
      "start": 67.025,
      "end": 75.09,
      "dur": 8.065,
      "pause_after": 0.3
    },
    {
      "id": "a2_9",
      "act": "act2",
      "scene": "stu_same",
      "text": "如果已经有同学问过，右侧会出现同题组。点一下同问，老师回复时一起收到。",
      "start": 75.39,
      "end": 82.131,
      "dur": 6.741,
      "pause_after": 0.35
    },
    {
      "id": "a2_10",
      "act": "act2",
      "scene": "stu_thread_end",
      "text": "提问、追问、同问，都在同一个线程里；换设备，也不会丢上下文。",
      "start": 82.481,
      "end": 88.28,
      "dur": 5.8,
      "pause_after": 0.45
    },
    {
      "id": "a3_1",
      "act": "act3",
      "scene": "archive_search",
      "text": "所有问答自动归档。可以按课程、状态、时间筛选，也能直接搜关键词。",
      "start": 89.53,
      "end": 96.031,
      "dur": 6.501,
      "pause_after": 0.3
    },
    {
      "id": "a3_2",
      "act": "act3",
      "scene": "archive_export",
      "text": "找到这道题，收藏、复制深链，或者把当前筛选导出成 CSV。",
      "start": 96.331,
      "end": 101.902,
      "dur": 5.572,
      "pause_after": 0.35
    },
    {
      "id": "a3_3",
      "act": "act3",
      "scene": "review",
      "text": "没弄懂的题，会进入复习卡。先自己想，再翻答案；记住了，或者还没会，系统会继续安排。",
      "start": 102.252,
      "end": 110.349,
      "dur": 8.097,
      "pause_after": 0.35
    },
    {
      "id": "a3_4",
      "act": "act3",
      "scene": "notify",
      "text": "老师回复、补充请求、转交状态，都会进通知中心；邮件提醒也可以单独打开。",
      "start": 110.699,
      "end": 117.674,
      "dur": 6.975,
      "pause_after": 0.3
    },
    {
      "id": "a3_5",
      "act": "act3",
      "scene": "notify",
      "text": "这些记录只属于当前账号，不会影响老师的待办，也不会改写课程知识库。",
      "start": 117.974,
      "end": 123.911,
      "dur": 5.937,
      "pause_after": 0.45
    },
    {
      "id": "a4_1",
      "act": "act4",
      "scene": "mentor_library",
      "text": "师说不只有课程答疑，还有三十三位学科导师。",
      "start": 125.161,
      "end": 129.025,
      "dur": 3.864,
      "pause_after": 0.3
    },
    {
      "id": "a4_2",
      "act": "act4",
      "scene": "mentor_library",
      "text": "五位试点导师默认开启，其余随选随加。文科、社科、法学、艺术，都能问。",
      "start": 129.325,
      "end": 136.539,
      "dur": 7.213,
      "pause_after": 0.3
    },
    {
      "id": "a4_3",
      "act": "act4",
      "scene": "humanities",
      "text": "古代文学按朝代梳理，近现代史拉时间线；艺术概论、刑法学、心理学、微观经济学，各有自己的知识地图。",
      "start": 136.839,
      "end": 146.255,
      "dur": 9.416,
      "pause_after": 0.4
    },
    {
      "id": "a4_4",
      "act": "act4",
      "scene": "mentor_method",
      "text": "导师不会直接灌答案：先定位卡点，再查先修，最后只点破关键一步。",
      "start": 146.655,
      "end": 152.581,
      "dur": 5.927,
      "pause_after": 0.3
    },
    {
      "id": "a4_5",
      "act": "act4",
      "scene": "kmap",
      "text": "工科还有交互式实验室。数电的卡诺图可以一步步化简，时序波形可以对照验证。",
      "start": 152.881,
      "end": 159.982,
      "dur": 7.1,
      "pause_after": 0.3
    },
    {
      "id": "a4_6",
      "act": "act4",
      "scene": "analog",
      "text": "模电的静态工作点，改一个参数，就能看波形怎么变。",
      "start": 160.282,
      "end": 164.33,
      "dur": 4.048,
      "pause_after": 0.35
    },
    {
      "id": "a4_7",
      "act": "act4",
      "scene": "mentor_end",
      "text": "导师和工具都在同一个入口，不需要装插件。",
      "start": 164.68,
      "end": 168.163,
      "dur": 3.484,
      "pause_after": 0.45
    },
    {
      "id": "a5_1",
      "act": "act5",
      "scene": "transfer",
      "text": "如果知识库没有足够依据，AI 不会编。它会明确说：这个问题我还没有可靠答案，然后转交任课老师。",
      "start": 169.413,
      "end": 178.175,
      "dur": 8.762,
      "pause_after": 0.35
    },
    {
      "id": "a5_2",
      "act": "act5",
      "scene": "teacher_queue",
      "text": "老师的待办台会收到这道题，连同学生原话、AI 检索记录和置信度。",
      "start": 178.525,
      "end": 184.586,
      "dur": 6.061,
      "pause_after": 0.3
    },
    {
      "id": "a5_3",
      "act": "act5",
      "scene": "teacher_queue",
      "text": "相似的问题自动合并成同题组，老师只需要处理一次。",
      "start": 184.886,
      "end": 189.491,
      "dur": 4.604,
      "pause_after": 0.35
    },
    {
      "id": "a5_4",
      "act": "act5",
      "scene": "teacher_drawer",
      "text": "打开这道 SPFA 题，右侧是 AI 的检索判断：知识库没有足够可靠的内容，只给一条相关线索，不生成答案。",
      "start": 189.841,
      "end": 199.007,
      "dur": 9.166,
      "pause_after": 0.3
    },
    {
      "id": "a5_5",
      "act": "act5",
      "scene": "teacher_drawer",
      "text": "下面是可以直接用的回复草稿。老师可以改，也可以请学生补充题目。",
      "start": 199.307,
      "end": 204.875,
      "dur": 5.568,
      "pause_after": 0.3
    },
    {
      "id": "a5_6",
      "act": "act5",
      "scene": "teacher_send",
      "text": "发送后，同组学生一起收到；这条回复同时沉淀成课程 FAQ，下次 AI 就能直接命中。",
      "start": 205.175,
      "end": 213.19,
      "dur": 8.016,
      "pause_after": 0.35
    },
    {
      "id": "a5_7",
      "act": "act5",
      "scene": "teacher_kb",
      "text": "发错了可以撤回，知识库有快照，可以回滚。",
      "start": 213.54,
      "end": 217.018,
      "dur": 3.478,
      "pause_after": 0.3
    },
    {
      "id": "a5_8",
      "act": "act5",
      "scene": "audit",
      "text": "每一次回复、撤回、修改，都会进操作审计。",
      "start": 217.318,
      "end": 221.174,
      "dur": 3.856,
      "pause_after": 0.45
    },
    {
      "id": "a6_1",
      "act": "act6",
      "scene": "teacher_kb_tour",
      "text": "教师端还有一套知识库工作台。新增、编辑、停用 FAQ，维护章节和口语别名。",
      "start": 222.424,
      "end": 229.903,
      "dur": 7.48,
      "pause_after": 0.3
    },
    {
      "id": "a6_2",
      "act": "act6",
      "scene": "teacher_import",
      "text": "支持 CSV、JSON 批量导入导出，导入前会做校验，不会把格式错误写进课程。",
      "start": 230.203,
      "end": 237.574,
      "dur": 7.371,
      "pause_after": 0.3
    },
    {
      "id": "a6_3",
      "act": "act6",
      "scene": "teacher_check",
      "text": "每条回复都可以自检：引用是否对齐、结论是否超出知识库、语气是否合适。",
      "start": 237.874,
      "end": 244.498,
      "dur": 6.624,
      "pause_after": 0.3
    },
    {
      "id": "a6_4",
      "act": "act6",
      "scene": "teacher_feedback",
      "text": "学生点“还不够”，会进入负反馈闭环；连续两次，相关知识降权，并提醒老师。",
      "start": 244.798,
      "end": 251.472,
      "dur": 6.673,
      "pause_after": 0.35
    },
    {
      "id": "a6_5",
      "act": "act6",
      "scene": "insights",
      "text": "答疑洞察把 AI 解决率、首次响应、同题合并、章节卡点热力放在一屏。",
      "start": 251.822,
      "end": 258.079,
      "dur": 6.258,
      "pause_after": 0.3
    },
    {
      "id": "a6_6",
      "act": "act6",
      "scene": "insights",
      "text": "老师看到的不只是答了多少，而是全班卡在哪。",
      "start": 258.379,
      "end": 262.144,
      "dur": 3.765,
      "pause_after": 0.3
    },
    {
      "id": "a6_7",
      "act": "act6",
      "scene": "insights",
      "text": "数据按课程和演示空间隔离，不会混到其他老师那里。",
      "start": 262.444,
      "end": 266.698,
      "dur": 4.254,
      "pause_after": 0.45
    },
    {
      "id": "a7_1",
      "act": "act7",
      "scene": "campus_map",
      "text": "课上的问题问老师，课下的事问学长。师说把校园经验也做成了可检索的知识库。",
      "start": 267.948,
      "end": 274.765,
      "dur": 6.816,
      "pause_after": 0.3
    },
    {
      "id": "a7_2",
      "act": "act7",
      "scene": "campus_cards",
      "text": "八百零四条经验卡，七大分类，每条都标来源和可信度；涉及政策、金额、截止日期，会提示以学校官方通知为准。",
      "start": 275.065,
      "end": 285.281,
      "dur": 10.217,
      "pause_after": 0.35
    },
    {
      "id": "a7_3",
      "act": "act7",
      "scene": "campus_map",
      "text": "三十六栋建筑的手绘地图，输入起点和终点，直接给路线。",
      "start": 285.631,
      "end": 290.453,
      "dur": 4.822,
      "pause_after": 0.3
    },
    {
      "id": "a7_4",
      "act": "act7",
      "scene": "canteen",
      "text": "图书馆可以查馆藏、看位置、找同类书；食堂收录一百零七个档口、三千七百五十八道菜，按口味和预算推荐。",
      "start": 290.753,
      "end": 300.108,
      "dur": 9.355,
      "pause_after": 0.4
    },
    {
      "id": "a7_5",
      "act": "act7",
      "scene": "campus_tools",
      "text": "校历、空教室、GPA 试算、教务课表与成绩，都在校园生活里。",
      "start": 300.508,
      "end": 306.086,
      "dur": 5.578,
      "pause_after": 0.3
    },
    {
      "id": "a7_6",
      "act": "act7",
      "scene": "chaoxing",
      "text": "学习通扫码绑定后，只读同步消息、作业、资料和章节，不保存密码。",
      "start": 306.386,
      "end": 312.342,
      "dur": 5.956,
      "pause_after": 0.3
    },
    {
      "id": "a7_7",
      "act": "act7",
      "scene": "mobile",
      "text": "手机端和安卓客户端也能用，桌面小组件会高亮当前课程。",
      "start": 312.642,
      "end": 317.66,
      "dur": 5.018,
      "pause_after": 0.45
    },
    {
      "id": "a8_1",
      "act": "act8",
      "scene": "admin_accounts",
      "text": "平台底座是独立管理台，九个模块：账号、课程分配、学生问答、风控审核、操作审计、AI 用量、内容运营、内容核实、系统与开发。",
      "start": 318.91,
      "end": 331.054,
      "dur": 12.144,
      "pause_after": 0.35
    },
    {
      "id": "a8_2",
