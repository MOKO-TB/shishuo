  "cues": [
    {
      "id": "f1_1",
      "act": "act1",
      "text": "欢迎观看师说全功能演示，接下来带你逐一体验从学生提问到管理审计的完整能力。",
      "start": 0.55,
      "end": 6.361,
      "duration": 5.811
    },
    {
      "id": "f2_1",
      "act": "act2",
      "text": "首先看学生端。选定课程后直接输入问题，支持深浅色切换与匿名提问，点击交给 AI。",
      "start": 7.311,
      "end": 14.658,
      "duration": 7.347
    },
    {
      "id": "f2_2",
      "act": "act2",
      "text": "上传课件或作业文档，系统会在本机解析正文作为上下文；右侧同步展示待答同题组，一键同问少排一次队。",
      "start": 15.408,
      "end": 24.079,
      "duration": 8.67
    },
    {
      "id": "f2_3",
      "act": "act2",
      "text": "AI 优先检索课程知识库，显性标注置信度、分步公式排版与原文出处；下方支持已解决确认、继续追问和复制深链。",
      "start": 24.829,
      "end": 34.254,
      "duration": 9.425
    },
    {
      "id": "f3_1",
      "act": "act3",
      "text": "在我的问答档案里，可按关键词、课程、时间与收藏精准检索，并一键导出当前结果为 CSV。",
      "start": 35.254,
      "end": 43.256,
      "duration": 8.003
    },
    {
      "id": "f3_2",
      "act": "act3",
      "text": "收藏与疑难问题会自动汇总进复习卡错题本，先自测再看答案，标记还没会的题目下次自动置顶。",
      "start": 44.006,
      "end": 51.782,
      "duration": 7.776
    },
    {
      "id": "f4_1",
      "act": "act4",
      "text": "当 AI 判断依据不足时，问题自动转交任课教师待办台，相同卡点智能合并，右侧实时预警知识缺口。",
      "start": 52.782,
      "end": 60.839,
      "duration": 8.057
    },
    {
      "id": "f4_2",
      "act": "act4",
      "text": "打开处理抽屉，AI 已备好检索判断与回复草稿；勾选沉淀为课程 FAQ 后发送，一次回复整组，且支持撤回与快照回滚。",
      "start": 61.589,
      "end": 71.568,
      "duration": 9.978
    },
    {
      "id": "f5_1",
      "act": "act5",
      "text": "进入课程知识库，健康度、引用次数与章节覆盖热力图一目了然，支持缺口一键生成草稿、知识库体检及批量导入导出。",
      "start": 72.618,
      "end": 82.097,
      "duration": 9.479
    },
    {
      "id": "f5_2",
      "act": "act5",
      "text": "答疑洞察自动统计 AI 独立解决率、教师平均首响与每周节省时长，让教学重点有据可依。",
      "start": 82.847,
      "end": 90.025,
      "duration": 7.178
    },
    {
      "id": "f6_1",
      "act": "act6",
      "text": "左侧随时呼出学科 AI 导师，提供结构化知识地图与卡点诊断；点开导师库，可在三十三位学科导师中自由添加或移除。",
