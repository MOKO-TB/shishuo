      "pause_after": 0.45
    },
    {
      "id": "a6_2",
      "act": "act6",
      "scene": "tea_queue",
      "text": "老师的时间，不该耗在重复回答基础题上。",
      "start": 115.937,
      "end": 119.236,
      "dur": 3.3,
      "pause_after": 0.4
    },
    {
      "id": "a6_3",
      "act": "act6",
      "scene": "tea_drawer",
      "text": "相似提问自动合并同题组，AI 备齐依据与回复草稿。",
      "start": 119.636,
      "end": 124.322,
      "dur": 4.686,
      "pause_after": 0.45
    },
    {
      "id": "a6_4",
      "act": "act6",
      "scene": "tea_precipitate",
      "text": "精答一次即同步整组并沉淀为 FAQ，下次 AI 直接命中。",
      "start": 124.772,
      "end": 130.216,
      "dur": 5.444,
