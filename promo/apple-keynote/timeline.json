      "end": 106.192,
      "dur": 3.52,
      "pause_after": 0.4
    },
    {
      "id": "a5_5",
      "act": "act5",
      "scene": "tool_analog",
      "text": "数电卡诺图化简与时序波形，模电静态工作点，步步可视验证。",
