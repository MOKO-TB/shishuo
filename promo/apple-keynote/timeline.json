  "lines": [
    {
      "id": "a1_1",
      "act": "act1",
      "scene": "opening_void",
      "text": "下课铃响，真正的思考才刚开始。",
      "start": 1.0,
      "end": 3.648,
      "dur": 2.648,
      "pause_after": 0.45
    },
    {
      "id": "a1_2",
      "act": "act1",
      "scene": "opening_pain",
      "text": "深夜推导卡壳，代码报错，波形对不上。",
      "start": 4.098,
      "end": 7.351,
      "dur": 3.252,
      "pause_after": 0.45
    },
    {
      "id": "a1_3",
      "act": "act1",
      "scene": "opening_three",
      "text": "问同学没人回，问通用 AI 怕编造又对不上课本，找老师又怕打扰。",
      "start": 7.801,
      "end": 13.525,
      "dur": 5.724,
      "pause_after": 0.6
    },
    {
      "id": "a1_4",
      "act": "act1",
      "scene": "opening_silence",
      "text": "无数本该被点亮的瞬间，留在了沉默里。",
      "start": 14.125,
      "end": 17.236,
      "dur": 3.111,
      "pause_after": 0.65
    },
    {
      "id": "a2_1",
      "act": "act2",
      "scene": "brand_beam",
      "text": "于是，我们重构了高校课后答疑。",
      "start": 18.586,
      "end": 21.118,
      "dur": 2.533,
      "pause_after": 0.4
    },
    {
      "id": "a2_2",
      "act": "act2",
      "scene": "brand_reveal",
      "text": "这就是，师说。",
      "start": 21.518,
      "end": 22.885,
      "dur": 1.367,
      "pause_after": 0.75
    },
    {
      "id": "a2_3",
      "act": "act2",
      "scene": "brand_tagline",
      "text": "课后敢问，课上讲透。不是替老师回答，而是让老师看见全班没弄懂的地方，然后讲得更准。",
      "start": 23.635,
      "end": 31.368,
      "dur": 7.732,
      "pause_after": 0.7
    },
    {
      "id": "a2_4",
      "act": "act2",
      "scene": "brand_stage",
      "text": "每句有出处，每问有回音，每课有积累。",
      "start": 32.068,
      "end": 35.289,
      "dur": 3.221,
      "pause_after": 0.75
    },
    {
      "id": "a3_1",
      "act": "act3",
      "scene": "engine_overview",
      "text": "我们打造了一条严谨的双通道接力引擎。",
      "start": 36.689,
      "end": 39.484,
      "dur": 2.796,
      "pause_after": 0.45
    },
    {
      "id": "a3_2",
      "act": "act3",
      "scene": "engine_retrieve",
      "text": "学生发问，先检索课程知识库，标明出处与三档置信度。",
      "start": 39.934,
      "end": 44.761,
      "dur": 4.826,
      "pause_after": 0.45
    },
    {
      "id": "a3_3",
      "act": "act3",
      "scene": "engine_honest",
      "text": "有依据立刻答；证据不足绝不编造，诚实拒答并转交老师。",
      "start": 45.211,
      "end": 50.256,
      "dur": 5.045,
      "pause_after": 0.5
    },
    {
      "id": "a3_4",
      "act": "act3",
      "scene": "engine_courses",
      "text": "已深耕高数、数据结构、电路、模电、数电五门核心课。",
      "start": 50.756,
      "end": 55.749,
      "dur": 4.993,
      "pause_after": 0.7
    },
    {
      "id": "a4_1",
      "act": "act4",
      "scene": "stu_home",
      "text": "学生端，一切围绕专注与效率。",
      "start": 57.049,
      "end": 59.521,
      "dur": 2.472,
      "pause_after": 0.4
    },
    {
      "id": "a4_2",
      "act": "act4",
      "scene": "stu_input",
      "text": "支持文字、语音、拍照识题与讲义文档提问。",
      "start": 59.921,
      "end": 63.783,
      "dur": 3.862,
      "pause_after": 0.4
    },
    {
      "id": "a4_3",
      "act": "act4",
      "scene": "stu_privacy",
      "text": "文件先在浏览器本机解析，经你确认才发送。",
      "start": 64.183,
      "end": 67.708,
      "dur": 3.525,
      "pause_after": 0.45
    },
    {
      "id": "a4_4",
      "act": "act4",
      "scene": "stu_thread",
      "text": "输入即匹配相近知识与同题组，轻点同问，少排一次队。",
      "start": 68.158,
      "end": 72.749,
      "dur": 4.591,
      "pause_after": 0.45
    },
    {
      "id": "a4_5",
      "act": "act4",
      "scene": "stu_archive",
      "text": "回答以公式精排流式呈现，追问上下文连贯。",
      "start": 73.199,
      "end": 76.871,
      "dur": 3.672,
      "pause_after": 0.45
    },
    {
      "id": "a4_6",
      "act": "act4",
      "scene": "stu_review",
      "text": "问答自动归档并支持导出，错题汇入复习卡自测。",
      "start": 77.321,
      "end": 81.56,
      "dur": 4.239,
      "pause_after": 0.65
    },
    {
      "id": "a5_1",
      "act": "act5",
      "scene": "avatar_stage",
      "text": "这是书灵，常驻桌面的伴学助教，也是 AI 导师的入口。",
      "start": 82.81,
      "end": 87.151,
      "dur": 4.341,
      "pause_after": 0.35
    },
    {
      "id": "a5_2",
      "act": "act5",
      "scene": "mentor_library",
      "text": "内置三十三位学科导师，五位试点默认开启，其余随选随加；近现代史、艺术概论、心理学、微观经济学，都能问。",
      "start": 87.501,
      "end": 97.334,
      "dur": 9.832,
      "pause_after": 0.45
    },
    {
      "id": "a5_3",
      "act": "act5",
      "scene": "mentor_method",
      "text": "它展开知识地图，定位卡点、查先修，点破关键一步。",
      "start": 97.784,
      "end": 102.222,
      "dur": 4.438,
      "pause_after": 0.45
    },
    {
      "id": "a5_4",
      "act": "act5",
      "scene": "tool_kmap",
      "text": "针对工科难点，更内置了交互式学科实验室。",
