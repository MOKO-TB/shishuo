    },
    {
      "id": "a6_6",
      "act": "act6",
      "scene": "tea_feedback",
      "text": "支持资料正文解析与口语别名；两次负反馈自动降权提醒。",
      "start": 134.858,
      "end": 139.801,
      "dur": 4.943,
      "pause_after": 0.45
    },
    {
      "id": "a6_7",
      "act": "act6",
      "scene": "tea_insights",
      "text": "答疑洞察呈现 AI 解决率、首响与章节卡点热力，帮老师把课讲得更准。",
      "start": 140.251,
      "end": 146.279,
      "dur": 6.028,
      "pause_after": 0.75
    },
    {
      "id": "a7_1",
      "act": "act7",
      "scene": "campus_intro",
      "text": "大学生的困惑，从不止于课本。",
