# 复制为 .env 后按需修改；.env 已被 gitignore，不要提交真实密钥。

# 服务端监听
HOST=127.0.0.1
PORT=8787
# 部署到 HTTPS 时设为 1，或直接设置 NODE_ENV=production
COOKIE_SECURE=0

# SQLite 数据库（相对路径按启动目录解析）
SHISHUO_DB=data/shishuo.db

# 题目图片存储目录（默认 data/uploads，已 gitignore）
SHISHUO_UPLOADS_DIR=data/uploads

# 对象存储：STORAGE_DRIVER=s3 时题目图片写入 S3 兼容服务（AWS S3 / MinIO / OSS 兼容模式）
# 缺凭证或配置不全会自动回落本地磁盘；本地驱动忽略以下 S3_* 变量
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 可选：对象访问域名（CDN / 自定义域名），不填用 endpoint/bucket 拼接
S3_PUBLIC_BASE=

# 演示账号：首次启动时创建 2 个学生账号和 5 个试点课程教师账号（teacher@ 为陈砚）
# 正式上线请设为 0
SHISHUO_DEMO_ACCOUNTS=1
DEMO_STUDENT_PASSWORD=student123
DEMO_TEACHER_PASSWORD=teacher123

# 独立管理端账号（/admin/）。它不是教师账号：不需要分配课程，只拥有管理权限。
# 生产环境务必修改 SHISHUO_ADMIN_PASSWORD。
SHISHUO_ADMIN_EMAIL=admin@shishuo.local
SHISHUO_ADMIN_PASSWORD=admin123

# 教师自助注册邀请码；留空表示关闭教师注册（演示教师账号仍可用）
TEACHER_INVITE_CODE=

# 验证码签名密钥；生产环境务必固定为长随机字符串，修改后旧验证码立即失效
AUTH_SECRET=

# 邮件：填写 SMTP_HOST 和 MAIL_FROM 后走真实 SMTP
# 不填 SMTP 时，开发环境默认把验证码打印到服务端日志并显示在登录页
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM=师说 <no-reply@shishuo.local>
# 本地开发显式启用验证码回显；生产环境不会生效
MAIL_DEV_MODE=1

# 服务端 AI 网关：推荐在 /admin/ 管理台配置 Key/Base URL/模型/额度。
# 管理台保存的 Key 存在数据库 app_settings 表，接口只返回掩码；下面这些环境变量作为初始兜底。
# 不填 AI_API_KEY 时，低置信问题会直接转交老师
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_DAILY_LIMIT=120
# 按角色覆盖每日额度（缺省回落 AI_DAILY_LIMIT）
AI_DAILY_LIMIT_STUDENT=120
AI_DAILY_LIMIT_TEACHER=120
# 内容审核词表：逗号分隔，命中任一词直接拒绝调用；留空关闭
AI_BLOCKLIST=
AI_TIMEOUT_MS=95000

# 服务端教务课表：学生输入教务账号/密码/验证码，服务端用 Chromium 换取登录态。
# 只允许白名单内的教务域名，避免把服务器当成任意 URL 代理。
JW_ALLOWED_HOSTS=jw.educationgroup.cn
# 仅本地 mock/测试时设为 1；生产环境保持 0
JW_ALLOW_LOCAL=0
