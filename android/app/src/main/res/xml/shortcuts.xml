<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="ask_camera"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher_round"
        android:shortcutShortLabel="@string/shortcut_camera_short"
        android:shortcutLongLabel="@string/shortcut_camera_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.shishuo.app"
            android:targetClass="com.shishuo.app.MainActivity">
            <extra android:name="shishuo_shortcut" android:value="camera" />
        </intent>
    </shortcut>

