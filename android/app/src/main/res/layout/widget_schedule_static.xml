<?xml version="1.0" encoding="utf-8"?>
<!-- 兼容版：只使用普通 RemoteViews，不依赖 ListView / RemoteViewsService，
     用于部分 OEM 桌面（如 ColorOS）无法添加集合小组件的情况。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_static_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="9dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/widget_static_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="第 12 周 · 周三"
            android:textColor="@color/widgetTitle"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_static_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="待上 4 节"
            android:textColor="@color/widgetAccent"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_static_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="打开师说同步课表后显示今日课程"
        android:textColor="@color/widgetMuted"
        android:textSize="11.5sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_static_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_row_bg"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="9dp"
        android:paddingTop="4dp"
        android:paddingEnd="9dp"
        android:paddingBottom="4dp"
        android:text="08:20  高等数学 · 教三 204"
        android:textColor="@color/widgetText"
        android:textSize="10.5sp" />

    <TextView
        android:id="@+id/widget_static_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:background="@drawable/widget_row_bg"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="9dp"
        android:paddingTop="4dp"
        android:paddingEnd="9dp"
        android:paddingBottom="4dp"
        android:text="10:15  大学英语 · 外语楼 302"
        android:textColor="@color/widgetText"
        android:textSize="10.5sp" />

    <TextView
        android:id="@+id/widget_static_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:background="@drawable/widget_row_bg"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="9dp"
        android:paddingTop="4dp"
        android:paddingEnd="9dp"
        android:paddingBottom="4dp"
        android:text="14:30  数据结构 · 计算机楼 401"
        android:textColor="@color/widgetText"
        android:textSize="10.5sp" />

    <TextView
        android:id="@+id/widget_static_row_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:background="@drawable/widget_row_bg"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="9dp"
        android:paddingTop="4dp"
        android:paddingEnd="9dp"
        android:paddingBottom="4dp"
        android:text="16:25  体育 · 东操场"
        android:textColor="@color/widgetText"
        android:textSize="10.5sp" />
</LinearLayout>
